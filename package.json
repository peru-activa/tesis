{
  "name": "@peru-activa/tesis",
  "version": "0.1.0",
  "private": true,
  "description": "Núcleo determinístico de recomendación de talleres con confirmación humana",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "check:no-ai": "node scripts/check-no-ai.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsx watch src/server.ts",
    "dev:web": "vite",
    "entrega:semana2": "node scripts/entregas/semana-02.mjs",
    "entrega:semana3": "node scripts/entregas/semana-03.mjs",
    "format:quotation": "prettier --write 'web/src/modules/quotation/**/*.{ts,tsx}'",
    "format:check:quotation": "prettier --check 'web/src/modules/quotation/**/*.{ts,tsx}'",
    "start": "node dist/server.js",
    "test": "node --import tsx --test 'test/**/*.test.ts'",
    "test:web": "vitest run --environment jsdom",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "verify": "npm run check:no-ai && npm run format:check:quotation && npm run typecheck && npm test && npm run test:web && npm run build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "express": "5.1.0",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.86.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/express": "5.0.3",
    "@types/node": "24.7.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
